# ============================================================
# FarmBridge — Docker Compose environment template
# ADF Phase 12 · Step 3
#
# Usage:
#   cp .env.example .env     # then edit .env with real values
#   docker compose up -d
#
# NEVER commit the real .env file — it is git-ignored.
# All values below are placeholders for local development.
# ============================================================

# --- MySQL container ---
MYSQL_DATABASE=farmbridge
MYSQL_USER=farmbridge
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# --- Backend (Spring Boot) ---
# Backend → MySQL uses the Compose service name `mysql` over the internal
# Docker network (never host.docker.internal).
DB_URL=jdbc:mysql://mysql:3306/farmbridge
DB_USERNAME=farmbridge
DB_PASSWORD=change-me
# JWT signing key — must be at least 32 characters in production.
JWT_SECRET=change-me-change-me-change-me-change-me

# --- Mail (SMTP) — placeholders; set real values for delivery ---
# For LOCAL development with no real SMTP, prefer a fast-fail endpoint so
# mail attempts fail instantly instead of hanging on external SMTP (the
# announcement endpoint emails every user synchronously):
#   MAIL_HOST=127.0.0.1
#   MAIL_PORT=2525
#   MAIL_USERNAME=
#   MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
APP_BASE_URL=http://localhost:5173
APP_RESET_PASSWORD_URL=http://localhost:5173/reset-password
APP_SUPPORT_EMAIL=support@farmbridge.com

# Backend timezone (QA's expired-token test requires host-clock alignment).
TZ=Asia/Kolkata

# --- Frontend (nginx) ---
# The nginx template renders /api + /uploads → $BACKEND_UPSTREAM.
# In Compose this must be the backend service name.
BACKEND_UPSTREAM=backend:8080

# ============================================================
# Render (production) — set these as environment variables on the
# backend Web Service in the Render dashboard. Placeholders only —
# real values live in Render's dashboard, never in this file.
#
# Render injects PORT automatically; the app binds server.port=${PORT:8080}.
# ============================================================
# JDBC URL must use the jdbc:mysql:// prefix (Aiven's dashboard "Service
# URI" uses mysql:// — convert it). Add SSL params for Aiven, e.g.:
#   DB_URL=jdbc:mysql://HOST:PORT/farmbridge?ssl-mode=REQUIRED
DB_URL=jdbc:mysql://HOST:PORT/farmbridge
DB_USERNAME=farmbridge
DB_PASSWORD=change-me
# JWT signing key — must be at least 32 characters.
JWT_SECRET=change-me-change-me-change-me-change-me
# Frontend origin for CORS + email deep links.
CORS_ALLOWED_ORIGINS=https://farmbridge-frontend.onrender.com
APP_BASE_URL=https://farmbridge-frontend.onrender.com
APP_RESET_PASSWORD_URL=https://farmbridge-frontend.onrender.com/reset-password
APP_SUPPORT_EMAIL=support@farmbridge.com
# Optional: Cloudinary credentials for persistent image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
